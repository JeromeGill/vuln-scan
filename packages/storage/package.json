{
  "name": "@repo/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config ./vitest.config.integration.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
