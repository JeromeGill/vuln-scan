{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "lib": ["es2023"],
    "removeComments": true,
    "sourceMap": true,
    "strictPropertyInitialization": false,
    "target": "ES2023",
    "outDir": "./dist",
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "test", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
