# direnv: point gcloud at this environment's project while in this directory
# (see docs/infrastructure.md#gcloud-project-per-directory). The project is
# read from terraform.tfvars (copied from terraform.tfvars.example).
if [ -f terraform.tfvars ]; then
  CLOUDSDK_CORE_PROJECT=$(sed -n 's/^project_id *= *"\(.*\)"$/\1/p' terraform.tfvars)
  export CLOUDSDK_CORE_PROJECT
fi
