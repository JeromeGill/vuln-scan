# Loaded by @repo/config (packages/config/src/shared.ts); docker compose also
# reads the DB_* values from .env. Variables already set in the shell win.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app

# API
PORT=3002
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The web origin: Better Auth is reached through the web app's /api/auth proxy.
BETTER_AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:3000

# Google sign-in (docs/auth.md#sign-in-with-google): the OAuth client's ID and
# secret (both or neither; unset, Google sign-in is off), and GOOGLE_SIGN_IN=true
# to show the button on the web, only once the api has them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_SIGN_IN=false

# Object storage (docs/storage.md): the fake-gcs emulator from
# docker-compose.yml. Without STORAGE_DRIVER the api runs without storage. For a real bucket, drop
# GCS_API_ENDPOINT and set GCS_CREDENTIALS to a service account key's JSON
# (or use Application Default Credentials), and optionally GCS_PROJECT_ID.
STORAGE_DRIVER=gcs
GCS_BUCKET=app
GCS_API_ENDPOINT=http://localhost:4443

# Web
API_URL=http://localhost:3002
# Next.js build directory (the browser tests set their own, .next-e2e).
NEXT_DIST_DIR=.next

# api (publishes jobs) and worker (docs/messaging.md). The credentials match
# docker-compose.yml.
RABBITMQ_URL=amqp://app:app@localhost:5672
JOB_RETRY_DELAYS_MS=10000,60000,300000
# Mailpit locally (inbox at http://localhost:8025); any SMTP server in production.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=My App <no-reply@app.localhost>

# Browser tests (apps/e2e): "dev" runs next dev, "prod" next build + next start.
E2E_MODE=dev
