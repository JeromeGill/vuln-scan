# Loaded before .env when NODE_ENV=test (e.g. by the integration tests); only
# values that differ from .env go here. The database must be named *_test,
# and so must the RabbitMQ vhost (the URL's path).
DB_NAME=app_test
RABBITMQ_URL=amqp://app:app@localhost:5672/app_test
# Short retry delays so the worker's retry tests finish quickly.
JOB_RETRY_DELAYS_MS=100,200,300
# The api's tests use their own bucket in the storage emulator.
GCS_BUCKET=app-test
